{"seq": 63, "t": 0.58, "round": 3, "agent": "Investigator", "kind": "query", "summary": "Wiki pages: titles, authors, freshness", "data": {"query_id": "q041", "sql": "SELECT page_id, title, labels, author_id, last_editor_id, updated_at, body FROM docs.pages", "engine": "local", "rows": 22, "ms": 0.2, "sources": ["docs"], "sample": [{"page_id": "4000", "title": "ADR-014: Idempotency keys scoped to merchant + amount + 24h", "labels": "adr", "author_id": "c01378315624d41338540baf", "last_editor_id": "c01378315624d41338540baf", "updated_at": "2025-09-09T18:00:00Z", "body": "# ADR-014: Idempotency keys scoped to merchant + amount + 24h\n\nSystem: Ledger Reconciliation\n\nWe key ledger writes on (merchant_id, amount_minor, currency, 24h bucket) instead of the gateway request id, because two acquirers retry with different request ids. Using request ids caused double postings.\n"}, {"page_id": "4001", "title": "Recon alert handling", "labels": "howto", "author_id": "560ad23e44526e057199afca", "last_editor_id": "fc51464f7e704d1cc7e1c3d1", "updated_at": "2025-03-20T18:00:00Z", "body": "# Recon alert handling\n\nSystem: Ledger Reconciliation\n\nWhen recon_break_count fires on the 1st of the month, silence it for 24 hours. Month-end accruals cause temporary breaks.\n"}, {"page_id": "4002", "title": "INC-231 postmortem: double settlement to Zenith", "labels": "postmortem", "author_id": "c01378315624d41338540baf", "last_editor_id": "c01378315624d41338540baf", "updated_at": "2026-01-08T18:00:00Z", "body": "# INC-231 postmortem: double settlement to Zenith\n\nSystem: Settlement Batch\n\nRoot cause: settlement batch rerun with --force bypassed the recon idempotency guard. Fix: --force requires a recon checkpoint id.\n"}]}}
