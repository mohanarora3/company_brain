# Copy to .env and fill in what you have. Placeholders only: never commit real values.
# Nothing here is required for the local demo: without Zetaris the agents query a local
# snapshot with the same table names, without an LLM key the writing falls back to templates.

# ---------------------------------------------------------------- data
LASTDAY_SEED=42                     # which generated company to use (python -m lastday generate --seed N)
# LASTDAY_ENGINE=auto               # auto | zetaris | local  (auto = Zetaris when configured)

# ---------------------------------------------------------------- Zetaris (docs/ZETARIS_SETUP.md)
# Direct REST API of your instance (local Docker install: port 8888).
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
# Numeric id under Management > Organisation in the Zetaris GUI.
ZETARIS_ORG_ID=
# Create under Management > API Tokens in the Zetaris GUI.
ZETARIS_API_KEY=
# Optional: UI-proxy route (port 3000) with username/password instead of the direct API.
ZETARIS_BASE_URL=
ZETARIS_USERNAME=
ZETARIS_PASSWORD=
ZETARIS_ENGINE_ID=
ZETARIS_QUERY_LIMIT=20000

# How Zetaris reaches Acme Pay's systems. With Zetaris in Docker on the same laptop,
# host.docker.internal points at your machine. For an AWS cluster use a public tunnel URL.
SAAS_PORT=8787
SAAS_PUBLIC_URL=http://host.docker.internal:8787
SAAS_TOKEN=change-me-to-a-random-string
HR_JDBC_URL=jdbc:postgresql://host.docker.internal:5433/acme_hr
HR_PG_USER=lastday
HR_PG_PASSWORD=change-me

# ---------------------------------------------------------------- Meterless (H-MEM + World Model)
METERLESS_BRIDGE_URL=http://127.0.0.1:7077
METERLESS_AUTOSTART=1               # the Python app starts the Node bridge itself

# ---------------------------------------------------------------- NVIDIA NIM (build.nvidia.com)
# One key covers both the LLM and the retrieval embeddings.
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# Any chat model id from build.nvidia.com works, e.g. a Nemotron model; copy the id from its model page.
LLM_MODEL=meta/llama-3.3-70b-instruct
EMBED_BASE_URL=https://integrate.api.nvidia.com/v1
EMBED_MODEL=nvidia/llama-3.2-nv-embedqa-1b-v2

# Any other OpenAI-compatible endpoint also works (xAI, OpenAI, a self-hosted NIM, the Meterless Runtime):
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_API_KEY=
# LLM_MODEL=
# LLM_EXTRA_HEADERS=                # "Header: value; Other: value"

PORT=8000
